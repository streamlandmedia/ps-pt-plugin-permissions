<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pictureshop.ptpluginperms.daemon</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/pictureshop/set-plugin-perms.sh</string>
	</array>

	<!-- Login is the only trigger. The per-user LaunchAgent touches
	     login.trigger at login; this daemon wakes, does the chmod as root,
	     and exits. The plug-in folders themselves are deliberately NOT
	     watched -- permissions are never changed mid-session. -->
	<key>WatchPaths</key>
	<array>
		<string>/Library/Application Support/PictureShop/PTPluginPerms/login.trigger</string>
	</array>

	<!-- No RunAtLoad: nothing should fire at boot, only at login. A login
	     always follows a boot, so nothing is missed. -->
	<key>RunAtLoad</key>
	<false/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>AbandonProcessGroup</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>
